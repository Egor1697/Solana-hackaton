# AgroShare Contract v1.0
from seahorse.prelude import *

declare_id('AgroShare1111111111111111111111111111111') # Заменится при деплое

class Asset(Account):
    admin: Pubkey
    description: str[64] # Например: "Трактор МТЗ-80"
    total_shares: u64     # Всего долей (например, 1000)
    price_per_share: u64 # Цена в лампортах (1 SOL = 10^9 лампортов)
    sold_shares: u64

class ShareHolder(Account):
    owner: Pubkey
    shares_count: u64

@instruction
def create_asset(admin: Signer, asset: Empty[Asset], desc: str[64], shares: u64, price: u64):
    # Инициализация актива (аналог __init__ в ООП)
    new_asset = asset.init(payer = admin, seeds = ['asset', desc])
    new_asset.admin = admin.key()
    new_asset.description = desc
    new_asset.total_shares = shares
    new_asset.price_per_share = price
    new_asset.sold_shares = 0

@instruction
def buy_share(user: Signer, asset: Asset, holder: Empty[ShareHolder], amount: u64):
    # Проверка: не продаем ли мы больше, чем есть [cite: 45]
    assert asset.sold_shares + amount <= asset.total_shares, 'Нет свободных долей'
    
    # Создаем запись о владельце
    new_holder = holder.init(payer = user, seeds = [user, asset.key()])
    new_holder.owner = user.key()
    new_holder.shares_count += amount
    
    # Обновляем состояние актива
    asset.sold_shares += amount
